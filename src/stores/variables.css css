:root {
  --tg-theme-bg-color: #0a0a0a;
  --tg-theme-text-color: #ffffff;
  --primary-bg: var(--tg-theme-bg-color, #0a0a0a);
  --surface-bg: #1a1a1a;
  --text-primary: var(--tg-theme-text-color, #ffffff);
  --accent-blue: #667eea;
  --accent-orange: #ff6b35;
  --accent-green: #00d4aa;
}

[data-theme="light"] {
  --primary-bg: #ffffff;
  --surface-bg: #f5f5f5;
  --text-primary: #1a1a1a;
}
