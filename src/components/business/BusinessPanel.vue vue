<template>
  <div class="business-panel">
    <div class="business-header">
      <button class="back-btn" @click="closePanel">
        ←
      </button>
      <h2>Бизнес-панель</h2>
    </div>
    
    <div class="business-content">
      <div class="business-nav">
        <button 
          v-for="tab in tabs" 
          :key="tab.id"
          class="business-nav-btn" 
          :class="{ active: activeTab === tab.id }"
          @click="activeTab = tab.id"
        >
          {{ tab.name }}
        </button>
      </div>

      <div class="business-section">
        <!-- Создание объявления -->
        <div v-if="activeTab === 'create'">
          <CreateAdForm @created="handleAdCreated" />
        </div>

        <!-- Мои объявления -->
        <div v-else-if="activeTab === 'my-ads'">
          <h3>Мои объявления</h3>
          <div v-if="userAds.length === 0" class="empty-state">
            <p>У вас пока нет объявлений</p>
            <button @click="activeTab = 'create'" class="btn-primary">
              Создать первое объявление
            </button>
          </div>
          <div v-else class="my-ads-list">
            <div 
              v-for="ad in userAds" 
              :key="ad.id" 
              class="ad-item"
            >
              <div class="ad-info">
                <h4>{{ ad.name }}</h4>
                <p>{{ ad.description }}</p>
                <div class="ad-stats">
                  <span>👁️ {{ ad.views || 0 }}</span>
                  <span>❤️ {{ ad.likes || 0 }}</span>
                  <span :class="`status-${ad.status}`">{{ getStatusText(ad.status) }}</span>
                </div>
              </div>
              <div class="ad-actions">
                <button @click="editAd(ad)" class="btn-small">✏️</button>
                <button @click="deleteAd(ad.id)" class="btn-small btn-danger">🗑️</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Аналитика -->
        <div v-else-if="activeTab === 'analytics'">
          <h3>Аналитика</h3>
          <div class="analytics-placeholder">
            <p>Статистика просмотров и взаимодействий</p>
            <!-- Здесь будет компонент аналитики -->
          </div>
        </div>

        <!-- Верификация -->
        <div v-else-if="activeTab === 'verification'">
          <h3>Верификация бизнеса</h3>
          <div class="verification-placeholder">
            <p>Проверка ИНН и верификация компании</p>
            <!-- Здесь будет форма верификации -->
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed } from 'vue'
import { useOffersStore } from '../../stores/offers.store'
import { useUserStore } from '../../stores/user.store'
import CreateAdForm from './CreateAdForm.vue'

const offersStore = useOffersStore()
const userStore = useUserStore()

const activeTab = ref('create')

const tabs = [
  { id: 'create', name: 'Создать объявление' },
  { id: 'my-ads', name: 'Мои объявления' },
  { id: 'analytics', name: 'Аналитика' },
  { id: 'verification', name: 'Верификация' }
]

// Вычисляем объявления текущего пользователя
const userAds = computed(() => {
  if (!userStore.user) return []
  return offersStore.offers.filter(ad => ad.user_id === userStore.user.id)
})

const closePanel = () => {
  // Эмитим событие закрытия
  if (typeof defineEmits === 'function') {
    const emit = defineEmits(['close'])
    emit('close')
  }
}

const handleAdCreated = (newAd) => {
  console.log('Объявление создано:', newAd)
  // Можно переключиться на вкладку "Мои объявления"
  activeTab.value = 'my-ads'
}

const editAd = (ad) => {
  console.log('Редактировать объявление:', ad)
  // Здесь будет логика редактирования
}

const deleteAd = async (adId) => {
  if (confirm('Вы уверены, что хотите удалить это объявление?')) {
    try {
      await offersStore.deleteOffer(adId)
      console.log('Объявление удалено')
    } catch (error) {
      console.error('Ошибка при удалении:', error)
      alert('Не удалось удалить объявление')
    }
  }
}

const getStatusText = (status) => {
  const statuses = {
    active: 'Активно',
    inactive: 'Неактивно',
    pending: 'На модерации'
  }
  return statuses[status] || status
}
</script>

