{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "nodeVersion": "22.x"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://d5djdb4t6ohnfrpfaaic.ql6wied2.apigw.yandexcloud.net/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "**/*.js": {
      "runtime": "nodejs22.x"
    }
  },
  "env": {
    "NODE_VERSION": "22"
  }
}
